# Keep LF line endings in the working tree on every OS (Prettier uses endOfLine: lf)
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.zip binary

# The saved GitHub pages of the tests are captured by a script: GitHub leaves them out of the language
# statistics (they are 99% of the HTML in the repository) and collapses their diffs
tests/e2e/fixtures/pages/** linguist-generated=true
