{
	"manifest_version": 3,
	"name": "Hyperfriend",
	"version": "2.6.0",
	"description": "Copy GitHub Pull Request and Issue links as rich hyperlinks, ready to paste into Teams, Slack and other chats.",
	"homepage_url": "https://github.com/borbiuk/hyperfriend",
	"browser_specific_settings": {
		"gecko": {
			"id": "hyperfriend@borbiuk",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"permissions": ["storage", "scripting"],
	"optional_host_permissions": ["https://*/*"],
	"background": {
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"js": ["content.js"],
			"matches": ["https://github.com/*"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Hyperfriend settings",
		"default_popup": "options.html",
		"default_icon": {
			"16": "assets/logo-16.png",
			"32": "assets/logo-32.png",
			"48": "assets/logo-48.png",
			"128": "assets/logo-128.png"
		}
	},
	"icons": {
		"16": "assets/logo-16.png",
		"32": "assets/logo-32.png",
		"48": "assets/logo-48.png",
		"128": "assets/logo-128.png"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
